```gitignore
# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and secrets
.env
.env.*
!.env.example
.venv/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# ==========================
# IDE and system files
# ==========================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ==========================
# Model weights and checkpoints
# ==========================
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.safetensors
*.weights

# Experiment-specific model artifacts
experiments/**/weights/
experiments/**/checkpoint.pth
experiments/**/final_state.pth
experiments/**/model_best.pth
experiments/**/checkpoint.pt
experiments/**/best.pt
experiments/**/last.pt

# ==========================
# Training logs and caches
# ==========================
runs/
wandb/
mlruns/
lightning_logs/
tensorboard/
*.cache
events.out.tfevents*

# ==========================
# Large generated artifacts
# ==========================
# Keep experiment metrics, reports, audit JSON and selected plots.
# Ignore bulky prediction/data artifacts only when appropriate.
*.prof
*.trace
*.npy
*.npz
*.parquet

# ==========================
# Dataset archives
# ==========================
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# COCO datasets
datasets/HRNet_COCO/
datasets/ViTPose_COCO/

# YOLO dataset images and labels
datasets/InnoCount_KeyPoint_YOLO26_Pose_v*/images/
datasets/InnoCount_KeyPoint_YOLO26_Pose_v*/labels/
datasets/InnoCount_KeyPoint_YOLO26_Pose_v*/checkpoints/

# ==========================
# Verified training dataset: explicitly keep
# ==========================
!datasets/InnoCount_KeyPoint_ModelReady_v2/
!datasets/InnoCount_KeyPoint_ModelReady_v2/**

# Still exclude model weights and archives inside this dataset
datasets/InnoCount_KeyPoint_ModelReady_v2/checkpoints/
datasets/InnoCount_KeyPoint_ModelReady_v2/weights/
datasets/InnoCount_KeyPoint_ModelReady_v2/**/*.pt
datasets/InnoCount_KeyPoint_ModelReady_v2/**/*.pth
datasets/InnoCount_KeyPoint_ModelReady_v2/**/*.ckpt
datasets/InnoCount_KeyPoint_ModelReady_v2/**/*.onnx
datasets/InnoCount_KeyPoint_ModelReady_v2/**/*.safetensors
datasets/InnoCount_KeyPoint_ModelReady_v2/**/*.zip

# Extracted Roboflow COCO dataset
/InnoCount KeyPoint.v4i.coco/

# Dataset images elsewhere under datasets/
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.bmp
datasets/**/*.webp
datasets/**/*.tif
datasets/**/*.tiff

# ==========================
# Temporary files
# ==========================
inspect_*.jpg
tmp/
temp/
.cache/
*.tmp
*.bak
*.swp
```

# ==========================
# ViTPose experiment artifacts
# ==========================
# Keep configs, logs, scalar metrics, and compact evaluation reports.
# Exclude model checkpoints; see docs/checkpoints.md for download instructions.
experiments/ViTPose_Runs/**/*.pth
experiments/ViTPose_Runs/**/*.pt
experiments/ViTPose_Runs/**/*.ckpt
experiments/ViTPose_Runs/**/*.onnx
experiments/ViTPose_Runs/**/*.safetensors

# Large per-instance prediction audits and generated visualizations.
experiments/ViTPose_Runs/**/vitpose_prediction_audit.jsonl
experiments/ViTPose_Runs/**/vis_data/
experiments/ViTPose_Runs/**/visualizations/
experiments/ViTPose_Runs/**/predictions/

# Generated defect-inference images; keep scripts and summary reports.
experiments/Defect_Inference/**/annotated/
experiments/Defect_Inference/**/*.jpg
experiments/Defect_Inference/**/*.jpeg
experiments/Defect_Inference/**/*.png
experiments/Defect_Inference/**/*.webp

# ==========================
# Third-party MMPose source
# ==========================
# Exclude the cloned repository and its Git history.
# Document the pinned version and clone command in docs/checkpoints.md.
third_party/mmpose/

# ViTPose runner state pointers may reference excluded checkpoint files
experiments/ViTPose_Runs/**/last_checkpoint
